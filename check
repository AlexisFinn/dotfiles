#!/usr/bin/env python3
"""Checks that every link declared in install.conf.yaml is still in place.

Programs that save a file by writing a new one and renaming it replace the
symlink with a regular file: the repository copy then silently goes stale.
Exits with status 1 when at least one problem is found.
"""
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent
try:
    import yaml
except ImportError:
    sys.path.insert(0, str(REPO / "dotbot" / "lib" / "pyyaml" / "lib"))
    import yaml

# Directories scanned for links into the repository that install.conf.yaml
# does not declare.
SCANNED = ["~", "~/bin", "~/.config"]
MISSING = "missing"


def declared_links():
    config = yaml.safe_load((REPO / "install.conf.yaml").read_text())
    for block in config:
        for dst, src in (block.get("link") or {}).items():
            if isinstance(src, dict):
                src = src.get("path")
            yield Path(os.path.expanduser(dst)), REPO / src


def status(dst, src):
    if not src.exists():
        return "source missing in the repository"
    if dst.is_symlink():
        if not dst.exists():
            return f"broken link -> {os.readlink(dst)}"
        if dst.resolve() != src.resolve():
            return f"points elsewhere -> {os.readlink(dst)}"
        return None
    if dst.exists():
        return "regular file or directory instead of a link"
    return MISSING


def undeclared(declared):
    for directory in SCANNED:
        directory = Path(os.path.expanduser(directory))
        if not directory.is_dir():
            continue
        for entry in sorted(directory.iterdir()):
            if not entry.is_symlink() or entry in declared:
                continue
            target = Path(os.path.realpath(entry))
            if REPO in target.parents:
                state = "undeclared link" if entry.exists() else "undeclared broken link"
                yield entry, f"{state} -> {os.readlink(entry)}"


def main():
    links = list(declared_links())
    found = [(dst, s) for dst, src in links if (s := status(dst, src))]
    found += undeclared({dst for dst, _ in links})
    # A link that is simply absent loses nothing: ./install creates it.
    absent = [dst for dst, message in found if message == MISSING]
    problems = [(dst, message) for dst, message in found if message != MISSING]
    for dst, message in found:
        print(f"{str(dst).replace(str(Path.home()), '~')}: {message}")
    print(f"{len(links)} links declared, {len(problems)} problem(s), "
          f"{len(absent)} to create with ./install")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
