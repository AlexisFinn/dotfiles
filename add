#!/usr/bin/env python3
"""Adopts a configuration file or directory into the repository.

Usage: ./add <path> [<path>...]

Each path is moved into the repository, replaced by a symlink and declared in
install.conf.yaml. The destination follows the path:

    ~/.config/<name>  ->  config/<name>
    ~/bin/<name>      ->  scripts/<name>
    ~/.<name>         ->  <name>
"""
import os
import shutil
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent
HOME = Path.home()
CONFIG = REPO / "install.conf.yaml"
LINK_HEADER = "- link:\n"


def destination(path):
    relative = path.relative_to(HOME)
    parts = relative.parts
    if parts[0] == ".config" and len(parts) == 2:
        return Path("config") / parts[1]
    if parts[0] == "bin" and len(parts) == 2:
        return Path("scripts") / parts[1]
    if len(parts) == 1 and parts[0].startswith("."):
        return Path(parts[0][1:])
    raise ValueError("only ~/.config/<name>, ~/bin/<name> and ~/.<name> are handled")


def adopt(argument):
    # The path is made absolute without resolving symlinks: an existing link
    # must be reported, not followed.
    path = Path(os.path.abspath(os.path.expanduser(argument)))
    if path.is_symlink():
        raise ValueError("already a symlink")
    if not path.exists():
        raise ValueError("does not exist")
    if HOME not in path.parents:
        raise ValueError("not under the home directory")
    relative_target = destination(path)
    target = REPO / relative_target
    if target.exists() or target.is_symlink():
        raise ValueError(f"{relative_target} already exists in the repository")

    declared = "~/" + path.relative_to(HOME).as_posix()
    source = relative_target.as_posix() + ("/" if path.is_dir() else "")
    text = CONFIG.read_text()
    if LINK_HEADER not in text:
        raise ValueError("no link section in install.conf.yaml")
    if f"      {declared}:" in text:
        raise ValueError("already declared in install.conf.yaml")

    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(path, target)
    path.symlink_to(target)
    entry = (
        f"      {declared}:\n"
        f"          path: {source}\n"
        "          create: true\n"
        "          force: false\n"
        "          relink: true\n"
    )
    CONFIG.write_text(text.replace(LINK_HEADER, LINK_HEADER + entry, 1))
    print(f"{declared} -> {relative_target}")


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip())
        return 2
    failed = False
    for argument in sys.argv[1:]:
        try:
            adopt(argument)
        except ValueError as error:
            print(f"{argument}: {error}", file=sys.stderr)
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
