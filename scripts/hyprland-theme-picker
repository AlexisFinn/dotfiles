#!/bin/bash
# Chooses the bar and the window frame of the Hyprland session.
#
#   hyprland-theme-picker                  picks what to change, then a value, in the DMS launcher
#   hyprland-theme-picker bar              picks a bar in the DMS launcher
#   hyprland-theme-picker bar <name>       switches to the bar ~/.config/quickshell/<name>
#   hyprland-theme-picker bar dms          stops every Quickshell bar and enables the DMS bar again
#   hyprland-theme-picker frame            picks a window frame in the DMS launcher
#   hyprland-theme-picker frame <style>    switches to that frame style
#   hyprland-theme-picker frame none       removes the frame, leaving the plain border
#   hyprland-theme-picker launcher         picks a launcher in the launcher itself
#   hyprland-theme-picker launcher bar     uses the launcher of the chosen bar, for Super+x and the menus
#   hyprland-theme-picker launcher dms     uses the DMS launcher whatever the bar
#   hyprland-theme-picker toggle-launcher  opens or closes the chosen launcher; meant for a key binding
#   hyprland-theme-picker dmenu [options]  a `dms dmenu` shown by the chosen launcher; meant for scripts
#   hyprland-theme-picker list             lists the choices, the current ones marked with *
#   hyprland-theme-picker status           prints the current choices
#   hyprland-theme-picker restore          starts the bar chosen last; meant for the session autostart
#
# A bar is any directory of ~/.config/quickshell holding a shell.qml; it may bring a launcher of
# its own, and the DMS one serves when it has none or when the DMS bar is chosen. The frame
# styles are those of ~/.config/hypr/scripts/gen-borders.py, drawn by the imgborders plugin.
set -euo pipefail

ME=$(basename "$0")
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/hyprland-theme-picker

# Quickshell identifies an instance by the path it was started with: bars are always addressed
# through this directory, never through the target of a link.
BARS_DIR=$HOME/.config/quickshell
DMS_SETTINGS=$(realpath "$HOME/.config/dms/settings.json")
DMS_BAR_ID=default
DMS=dms

GEN_BORDERS=$HOME/.config/hypr/scripts/gen-borders.py
BORDERS_META=$HOME/.cache/hypr-theme/borders.lua
FRAME_PLUGIN=imgborders
FRAME_PLUGIN_URL=https://codeberg.org/zacoons/imgborders
# Read by hyprland.lua when the choice file is missing; keep both in step.
DEFAULT_FRAME=steam
NO_FRAME=none

remember() {
    mkdir -p "$STATE_DIR"
    echo "$2" > "$STATE_DIR/$1"
}

recall() {
    cat "$STATE_DIR/$1" 2>/dev/null || true
}

# Shows the newline-separated choices of $2 in the chosen launcher, the one equal to $3 marked,
# and prints the chosen one. Fails when the launcher is cancelled.
pick() {
    local prompt=$1 choices=$2 active=$3 message=${4:-} index
    index=$(grep -nxF -- "$active" <<< "$choices" | cut -d: -f1 || true)
    local args=(-p "$prompt" --no-custom)
    [ -n "$index" ] && args+=(-a "$((index - 1))")
    [ -n "$message" ] && args+=(--mesg "$message")
    menu "${args[@]}" <<< "$choices"
}

# Bars ---------------------------------------------------------------------------------------------

bars() {
    local shell
    for shell in "$BARS_DIR"/*/shell.qml; do
        [ -f "$shell" ] && basename "$(dirname "$shell")"
    done
    return 0
}

is_bar() {
    [ "$1" != "$DMS" ] && [ -f "$BARS_DIR/$1/shell.qml" ]
}

bar_running() {
    qs list --all 2>/dev/null | grep -qF "$BARS_DIR/$1/shell.qml"
}

current_bar() {
    local name
    name=$(recall bar)
    if [ -n "$name" ] && is_bar "$name"; then echo "$name"; else echo "$DMS"; fi
}

# DMS watches its settings file and adds or removes its bar at once.
set_dms_bar() {
    local actual tmp
    actual=$(jq --arg id "$DMS_BAR_ID" '.barConfigs[] | select(.id == $id) | .enabled' "$DMS_SETTINGS")
    [ "$actual" = "$1" ] && return 0
    tmp=$(mktemp "$DMS_SETTINGS.XXXXXX")
    jq --arg id "$DMS_BAR_ID" --argjson enabled "$1" \
        '(.barConfigs[] | select(.id == $id) | .enabled) = $enabled' "$DMS_SETTINGS" > "$tmp"
    /usr/bin/mv -f "$tmp" "$DMS_SETTINGS"
}

switch_bar() {
    local name=$1 other
    if [ "$name" != "$DMS" ] && ! is_bar "$name"; then
        echo "$ME: no bar named '$name' in $BARS_DIR" >&2
        exit 1
    fi
    for other in $(bars); do
        if [ "$other" != "$name" ] && bar_running "$other"; then
            qs kill -p "$BARS_DIR/$other" >/dev/null
        fi
    done
    if [ "$name" = "$DMS" ]; then
        set_dms_bar true
    else
        set_dms_bar false
        qs -n -d -p "$BARS_DIR/$name" >/dev/null 2>&1 || true
    fi
    remember bar "$name"
}

pick_bar() {
    local choice
    choice=$(pick "Barre" "$( { bars; echo "$DMS"; } )" "$(current_bar)") || return 0
    [ -n "$choice" ] && switch_bar "$choice"
}

# Launcher -----------------------------------------------------------------------------------------

BAR_LAUNCHER=bar

current_launcher() {
    if [ "$(recall launcher)" = "$DMS" ]; then echo "$DMS"; else echo "$BAR_LAUNCHER"; fi
}

# Prints the directory of the bar whose launcher serves; fails when the DMS one does.
launcher_bar() {
    local bar
    bar=$(current_bar)
    [ "$(current_launcher)" = "$BAR_LAUNCHER" ] && [ "$bar" != "$DMS" ] && echo "$BARS_DIR/$bar"
}

toggle_launcher() {
    local dir
    if dir=$(launcher_bar) && qs ipc -p "$dir" call launcher toggle >/dev/null 2>&1; then
        return 0
    fi
    dms ipc call launcher toggle >/dev/null
}

# Prints the JSON list of the row positions in a spec such as "0,3"; fails on any other form.
positions() {
    [[ "$1" =~ ^[0-9]+(,[0-9]+)*$ ]] && echo "[$1]"
}

# `dms dmenu` with the same options, shown by the launcher of the bar where it can be: the rows
# come on stdin, the choice goes to stdout, and a cancelled menu fails. The options the bar's
# launcher does not know, and a bar without a launcher, go to DMS.
menu() {
    local dir prompt="" message="" placeholder="" active="[]" urgent="[]" format=s
    local prompt_only=false no_custom=false known=true args=("$@")
    while [ $# -gt 0 ] && $known; do
        case "$1" in
        -p | --prompt) prompt=${2:-}; shift ;;
        --mesg) message=${2:-}; shift ;;
        --placeholder) placeholder=${2:-}; shift ;;
        -a | --active) active=$(positions "${2:-}") || known=false; shift ;;
        -u | --urgent) urgent=$(positions "${2:-}") || known=false; shift ;;
        --format) format=${2:-}; [ "$format" = s ] || [ "$format" = i ] || known=false; shift ;;
        --prompt-only) prompt_only=true ;;
        --no-custom) no_custom=true ;;
        -i | --case-insensitive) ;;
        *) known=false ;;
        esac
        shift || true
    done
    if ! $known || ! dir=$(launcher_bar); then
        dms dmenu "${args[@]}"
        return
    fi

    local work items status text position
    work=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/hyprland-theme-picker.XXXXXX")
    mkfifo "$work/reply"
    if $prompt_only; then items="[]"; else items=$(jq -Rn '[inputs]'); fi
    jq -n --argjson items "$items" --argjson active "$active" --argjson urgent "$urgent" \
        --arg prompt "$prompt" --arg message "$message" --arg placeholder "$placeholder" \
        --argjson promptOnly "$prompt_only" --argjson noCustom "$no_custom" --arg reply "$work/reply" \
        '$ARGS.named' > "$work/request.json"
    # Opened for reading and writing, so that waiting for the answer can time out.
    exec 3<> "$work/reply"
    if ! qs ipc -p "$dir" call launcher menu "$work/request.json" >/dev/null 2>&1; then
        exec 3>&-
        /usr/bin/rm -rf "$work"
        jq -r '.[]' <<< "$items" | dms dmenu "${args[@]}"
        return
    fi
    status=cancel
    read -r -t 3600 -u 3 status && read -r -t 5 -u 3 text && read -r -t 5 -u 3 position || true
    exec 3>&-
    /usr/bin/rm -rf "$work"
    [ "$status" = ok ] || return 1
    if [ "$format" = i ]; then echo "$position"; else echo "$text"; fi
}

switch_launcher() {
    if [ "$1" != "$BAR_LAUNCHER" ] && [ "$1" != "$DMS" ]; then
        echo "$ME: no launcher named '$1'; launchers: $BAR_LAUNCHER $DMS" >&2
        exit 1
    fi
    remember launcher "$1"
}

pick_launcher() {
    local choice
    choice=$(pick "Lanceur" "$BAR_LAUNCHER"$'\n'"$DMS" "$(current_launcher)") || return 0
    [ -n "$choice" ] && switch_launcher "$choice"
}

# Window frames ------------------------------------------------------------------------------------

frames() {
    "$GEN_BORDERS" --list
}

is_frame() {
    [ "$1" = "$NO_FRAME" ] || frames | grep -qxF -- "$1"
}

current_frame() {
    local style
    style=$(recall frame)
    if [ -n "$style" ] && is_frame "$style"; then echo "$style"; else echo "$DEFAULT_FRAME"; fi
}

# Prints why the frames cannot be drawn, with the commands that fix it; nothing when they can.
frame_plugin_problem() {
    if hyprctl plugin list 2>/dev/null | grep -q "^Plugin $FRAME_PLUGIN "; then
        return 0
    fi
    if hyprpm list 2>/dev/null | grep -q "Plugin $FRAME_PLUGIN\$"; then
        echo "plugin $FRAME_PLUGIN installé mais pas chargé : hyprpm enable $FRAME_PLUGIN && hyprpm reload"
    else
        echo "plugin $FRAME_PLUGIN absent : hyprpm add $FRAME_PLUGIN_URL && hyprpm enable $FRAME_PLUGIN && hyprpm reload"
    fi
}

warn_frame_plugin() {
    local problem
    problem=$(frame_plugin_problem)
    [ -z "$problem" ] && return 0
    echo "$ME: attention, $problem" >&2
    echo "$ME: le style choisi est mémorisé et s'appliquera une fois le plugin chargé." >&2
}

switch_frame() {
    local style=$1
    if ! is_frame "$style"; then
        echo "$ME: no frame style named '$style'; styles: $(frames | tr '\n' ' ')$NO_FRAME" >&2
        exit 1
    fi
    warn_frame_plugin
    if [ "$style" != "$NO_FRAME" ] && ! grep -q "^  $style = " "$BORDERS_META" 2>/dev/null; then
        "$GEN_BORDERS"
    fi
    remember frame "$style"
    # hyprland.lua reads the choice at load time.
    hyprctl reload >/dev/null
}

pick_frame() {
    local choice problem
    problem=$(frame_plugin_problem)
    choice=$(pick "Bordures" "$( { frames; echo "$NO_FRAME"; } )" "$(current_frame)" \
        "${problem:+Attention : $problem}") || return 0
    [ -n "$choice" ] && switch_frame "$choice"
}

# Commands -----------------------------------------------------------------------------------------

marked() {
    local active=$1 name
    while read -r name; do
        if [ "$name" = "$active" ]; then echo "  * $name"; else echo "    $name"; fi
    done
}

case "${1:-}" in
"")
    kind=$(pick "Thème" "Barre : $(current_bar)"$'\n'"Bordures : $(current_frame)"$'\n'"Lanceur : $(current_launcher)" "") || exit 0
    case "$kind" in
    Barre*) pick_bar ;;
    Bordures*) pick_frame ;;
    Lanceur*) pick_launcher ;;
    esac
    ;;
bar)
    if [ $# -ge 2 ]; then switch_bar "$2"; else pick_bar; fi
    ;;
frame)
    if [ $# -ge 2 ]; then switch_frame "$2"; else pick_frame; fi
    ;;
launcher)
    if [ $# -ge 2 ]; then switch_launcher "$2"; else pick_launcher; fi
    ;;
toggle-launcher)
    toggle_launcher
    ;;
dmenu)
    shift
    menu "$@"
    ;;
list)
    echo "bar"
    { bars; echo "$DMS"; } | marked "$(current_bar)"
    echo "frame"
    { frames; echo "$NO_FRAME"; } | marked "$(current_frame)"
    echo "launcher"
    printf '%s\n' "$BAR_LAUNCHER" "$DMS" | marked "$(current_launcher)"
    warn_frame_plugin
    ;;
status)
    echo "bar: $(current_bar)"
    echo "frame: $(current_frame)"
    echo "launcher: $(current_launcher)"
    warn_frame_plugin
    ;;
restore)
    switch_bar "$(current_bar)"
    ;;
-h | --help | help)
    sed -n '2,22p' "$0" | sed 's/^# \?//'
    ;;
*)
    echo "$ME: unknown command '$1'; see $ME help" >&2
    exit 2
    ;;
esac
